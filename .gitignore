node_modules
dist
.DS_Store
*.local
tsconfig.tsbuildinfo
vite.config.ts.timestamp-*

# Export redundante: sus archivos ya estan sueltos en figma/
figma/*.zip

# El repo es publico: cualquiera lo clona. El calendario de premios trae fecha
# y hora exactas de las 89 entregas, o sea la mecanica completa de la promo.
# Se trabaja con el archivo en local, pero no se sube. El catalogo derivado
# —nombres, cantidades e imagenes, sin horarios— vive en docs/PREMIOS-2026.md.
recursos/premios/*.xlsx

# Variables locales: pueden traer claves. Se versiona solo .env.example
.env
.env.*
!.env.example
deploy/production.env
audit-shots/

# capturas de auditoria visual (se generan en el scratchpad)
actual/

# comparaciones generadas por scripts/figma-check.mjs
figma/check/

# assets bajados por `figma:pull --export`: son la copia cruda del nodo. La que
# se usa vive en src/assets/, versionada; esta se puede volver a bajar.
figma/assets/
