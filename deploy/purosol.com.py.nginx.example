# EJEMPLO para el Nginx DEL SERVIDOR del cliente.
# El cliente debe adaptar las rutas de certificados a su infraestructura.

server {
    listen 80;
    listen [::]:80;
    server_name purosol.com.py www.purosol.com.py;
    server_tokens off;
    return 301 https://purosol.com.py$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name purosol.com.py;
    server_tokens off;

    ssl_certificate     /RUTA/AL/fullchain.pem;
    ssl_certificate_key /RUTA/AL/privkey.pem;

    # Copiar deploy/security-headers.conf a esta ruta antes de recargar Nginx.
    include /etc/nginx/snippets/codigos-secretos-security.conf;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        # El proxy HTTPS fija una única copia de cada cabecera, aunque el
        # contenedor también se consulte directamente durante el diagnóstico.
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header X-Frame-Options;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.purosol.com.py;
    server_tokens off;

    ssl_certificate     /RUTA/AL/fullchain.pem;
    ssl_certificate_key /RUTA/AL/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    return 301 https://purosol.com.py$request_uri;
}
