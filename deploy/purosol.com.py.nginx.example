# EJEMPLO para el Nginx DEL SERVIDOR del cliente.
# El cliente debe adaptar las rutas de certificados a su infraestructura.

server {
    listen 80;
    listen [::]:80;
    server_name purosol.com.py www.purosol.com.py;
    return 301 https://purosol.com.py$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name purosol.com.py;

    ssl_certificate     /RUTA/AL/fullchain.pem;
    ssl_certificate_key /RUTA/AL/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.purosol.com.py;

    ssl_certificate     /RUTA/AL/fullchain.pem;
    ssl_certificate_key /RUTA/AL/privkey.pem;

    return 301 https://purosol.com.py$request_uri;
}
