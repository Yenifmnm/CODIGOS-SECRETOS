# Copiar como deploy/production.env en el servidor.
# deploy/production.env está ignorado por Git y nunca debe incorporarse a una
# imagen, commit o archivo que se entregue públicamente.

# URL pública del backend ya publicado, sin barra final.
VITE_API_URL=https://promo.edge.com.py/purosol

# Clave pública del sitio de reCAPTCHA Enterprise del proyecto.
VITE_RECAPTCHA_SITE_KEY=6LfcYIQtAAAAAAqpWHzZ6y-cTCPOPEBXIu8XJWOD

# Puerto local al que apuntará el proxy HTTPS del servidor.
FRONTEND_PORT=8080

# Etiqueta de la imagen para poder volver a una versión anterior.
IMAGE_TAG=produccion
